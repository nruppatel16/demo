# Copy to .env and fill in. .env is git-ignored and must NEVER be committed.
# Use PAPER-ACCOUNT keys only. This system has no live-trading path.

# --- Alpaca paper credentials (https://app.alpaca.markets/ -> Paper account) ---
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# --- Universe & data ---
SYMBOLS=SPY              # comma-separated, e.g. SPY,QQQ,AAPL
TIMEFRAME=1Day           # 1Min | 5Min | 15Min | 1Hour | 1Day
DATA_DIR=data_store      # local cache + duckdb location

# --- Backtest ---
INITIAL_CAPITAL=100000.0  # starting paper equity for backtests

# --- Strategy parameters ---
STRATEGY_NAME=sma_crossover   # sma_crossover | buy_and_hold | llm
SMA_FAST_WINDOW=20
SMA_SLOW_WINDOW=50

# --- Risk parameters (applied uniformly to backtest AND live) ---
MAX_POSITION_PCT=0.25            # max fraction of equity per single position
MAX_PORTFOLIO_DRAWDOWN_PCT=0.20  # portfolio kill-switch threshold
# STOP_LOSS_PCT=0.10             # optional per-position stop loss (leave unset to disable)

# --- Backtest assumptions ---
SLIPPAGE_BPS=5.0         # modeled slippage per fill, in basis points

# --- Live scheduling ---
SCHEDULE_INTERVAL_MINUTES=5  # how often the live loop runs (during market hours)

# --- Logging ---
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false           # true -> JSON logs, false -> human-readable console

# --- Phase 6: LLM strategy (optional) ---
# ANTHROPIC_API_KEY=your_anthropic_key_here
# LLM_MODEL=claude-haiku-4-5-20251001   # cheapest; change for quality vs cost tradeoff
# LLM_LOOKBACK_BARS=20                  # bars of history sent to the model
# LLM_CACHE_DIR=llm_cache               # where to cache LLM responses (avoids redundant API calls)
